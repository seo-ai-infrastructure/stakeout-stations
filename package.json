{
  "name": "stakeout-stations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-map-worker.mjs",
    "prebuild": "node scripts/prepare-map-worker.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
